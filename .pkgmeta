#
# In the source repo every sub-addon folder lives INSIDE Forge/SubAddons/
# (so the git repo has a single top-level addon and one nested SubAddons/
# container). On release the move-folders directives below lift each
# sub-addon back out so it sits next to Forge/ in the zip.
#
# Sync-WoWAddons.ps1 treats SubAddons/ as a transparent container, so
# during local dev each sub-addon still appears as a top-level junction
# under Interface/AddOns/ exactly as it would after install.

package-as: Forge

# Move sub-addons out of the Forge/SubAddons/ staging folder so they
# become siblings in the final zip (and therefore install as independent
# addons).
move-folders:
  Forge/SubAddons/Forge_APIRef:                                       Forge_APIRef
  Forge/SubAddons/Forge_APIRef-AbbreviateConfigAPI:                   Forge_APIRef-AbbreviateConfigAPI
  Forge/SubAddons/Forge_APIRef-AbbreviatedNumberFormatterAPI:         Forge_APIRef-AbbreviatedNumberFormatterAPI
  Forge/SubAddons/Forge_APIRef-AccountConstants:                      Forge_APIRef-AccountConstants
  Forge/SubAddons/Forge_APIRef-Action:                                Forge_APIRef-Action
  Forge/SubAddons/Forge_APIRef-ActionBarShared:                       Forge_APIRef-ActionBarShared
  Forge/SubAddons/Forge_APIRef-AddOnProfilerConstants:                Forge_APIRef-AddOnProfilerConstants
  Forge/SubAddons/Forge_APIRef-AppearanceSource:                      Forge_APIRef-AppearanceSource
