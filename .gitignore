# Forge .gitignore
#
# All dev-local artifacts (release.ps1, future tools, caches, scratch)
# live under /.dev/ at the repo root. One folder, one ignore line. Add
# new tooling artifacts there and you don't have to touch this file.
.dev/

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# Editors
*.swp
*.swo
*~
.idea/
*.iml
*.code-workspace
.vscode/

# Lua build/bytecode
*.luac
.rocks/
lua_modules/

# WoW packager output (BigWigs Packager / wow-packager)
.release/
.pkgmeta-cache/

# Logs, scratch, temp
*.log
*.bak
*.tmp
*.orig
*.rej

# Local dev scratch dirs
scratch/
tmp/
